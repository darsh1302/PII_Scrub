# Secrets — never commit
.env
*.pem
*.pfx
*.p12
*.key
credentials
*_secret*

# Runtime state — audit trail, scan workspace, temp artifacts. One directory to
# ignore and one to wipe, rather than several to remember.
var/

# Generated sample data. data/samples/sample.txt is committed as a small demo
# input; the large ones are reproducible from tools_dev/make_big_sample.py.
data/samples/large.txt
data/samples/sample_large.txt
data/samples/sample_bigger.txt
*-cleaned.txt
*-findings.json

# Extracted source documents — the .docx is the artifact of record.
docs/source/*.extracted.md

# Python
venv/
.venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/
*.egg-info/
build/
dist/

# Temp artifacts from the session temp-dir sweep
pii_agent_*/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
