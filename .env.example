# PII Scrubbing Agent — configuration template
# Copy to .env and fill in. NEVER commit .env.

# --- Required ---------------------------------------------------------------
# The deterministic scrub core does not need this; only conversational
# orchestration does.
OPENAI_API_KEY=sk-...

# --- Security ---------------------------------------------------------------
# Salt for the HASH scrub action. Without it a random per-process salt is used
# and HASH output will not be stable across restarts.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PII_AGENT_TOKEN_VAULT_SALT=

# Allowlist of directories the agent may read (guardrail G8).
# Semicolon-separated on Windows, colon-separated elsewhere.
# Leave empty to allow uploaded files ONLY — it never means "whole filesystem".
# Paths outside these roots are refused, as are sensitive paths within them
# (.env, id_rsa, *.pem, .aws/**, .ssh/**, .kube/**) regardless of root.
#
# Keep this narrow. Pointing it at the repository root would put .env — holding
# this key and the vault salt — inside the agent's reach.
PII_AGENT_SCAN_ROOTS=C:\logs;C:\temp\scan

# --- Deployment (guardrail G10) --------------------------------------------
# This service reads the local filesystem and CloudWatch logs using the host's
# credentials and has NO authentication of its own. On a non-loopback address
# that access is available to any network peer.
#
# Startup refuses a non-loopback bind unless PII_AGENT_ALLOW_REMOTE=true.
# Only set that with an authenticating reverse proxy in front.
PII_AGENT_BIND_ADDRESS=127.0.0.1
PII_AGENT_ALLOW_REMOTE=false

# --- Audit (guardrail G20) -------------------------------------------------
# Append-only hash-chained JSONL. Must be writable or processing is refused.
# Runtime state lives under var/, which is gitignored in its entirety.
PII_AGENT_AUDIT_DIR=var/audit

# --- AWS (optional, for the CloudWatch source) -----------------------------
# Standard credential chain is used if these are unset.
AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ===========================================================================
# GenAI Architecture Explorer
# ===========================================================================
# The PII agent needs none of the following. It has no database dependency and
# runs exactly as before with this whole section absent — dependency rule D1
# keeps it that way.

# --- Persistence -----------------------------------------------------------
# A local development instance is provided by tools_dev/pg_local.py, which
# installs PostgreSQL under var/ without administrator rights and prints both
# URLs below. It listens on 127.0.0.1:5433 — not 5432, so it cannot silently
# shadow a system Postgres.
#
#   python tools_dev/pg_local.py install
#   python tools_dev/pg_local.py start
#
# Two separate databases, not one. The test suite truncates and drops freely, so
# sharing a database with development data would mean a test run destroys
# whatever was being examined — which is how people stop running the tests.
EXPLORER_DATABASE_URL=postgresql://explorer_admin:CHANGEME@127.0.0.1:5433/explorer_dev
EXPLORER_TEST_DATABASE_URL=postgresql://explorer_admin:CHANGEME@127.0.0.1:5433/explorer_test

# --- Object store ----------------------------------------------------------
# Content payloads live outside Postgres so deleting a large artifact does not
# rewrite a table, and so originals and sanitized output can sit on independent
# retention clocks (R14.4).
#
# "filesystem" is the local adapter. "s3" uses the same interface against any
# S3-compatible endpoint; set EXPLORER_OBJECT_STORE_BUCKET and the standard AWS
# credential variables above.
EXPLORER_OBJECT_STORE=filesystem
EXPLORER_OBJECT_STORE_ROOT=var/object_store
# EXPLORER_OBJECT_STORE_BUCKET=
# EXPLORER_OBJECT_STORE_ENDPOINT=
