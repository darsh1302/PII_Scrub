# PII Scrubbing Agent — configuration template
# Copy to .env and fill in. NEVER commit .env.

# --- Required ---------------------------------------------------------------
# The deterministic scrub core does not need this; only conversational
# orchestration does.
OPENAI_API_KEY=sk-...

# --- Security ---------------------------------------------------------------
# Salt for the HASH scrub action. Without it a random per-process salt is used
# and HASH output will not be stable across restarts.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PII_AGENT_TOKEN_VAULT_SALT=

# Allowlist of directories the agent may read (guardrail G8).
# Semicolon-separated on Windows, colon-separated elsewhere.
# Leave empty to allow uploaded files ONLY — it never means "whole filesystem".
# Paths outside these roots are refused, as are sensitive paths within them
# (.env, id_rsa, *.pem, .aws/**, .ssh/**, .kube/**) regardless of root.
#
# Keep this narrow. Pointing it at the repository root would put .env — holding
# this key and the vault salt — inside the agent's reach.
PII_AGENT_SCAN_ROOTS=C:\logs;C:\temp\scan

# --- Deployment (guardrail G10) --------------------------------------------
# This service reads the local filesystem and CloudWatch logs using the host's
# credentials and has NO authentication of its own. On a non-loopback address
# that access is available to any network peer.
#
# Startup refuses a non-loopback bind unless PII_AGENT_ALLOW_REMOTE=true.
# Only set that with an authenticating reverse proxy in front.
PII_AGENT_BIND_ADDRESS=127.0.0.1
PII_AGENT_ALLOW_REMOTE=false

# --- Audit (guardrail G20) -------------------------------------------------
# Append-only hash-chained JSONL. Must be writable or processing is refused.
# Runtime state lives under var/, which is gitignored in its entirety.
PII_AGENT_AUDIT_DIR=var/audit

# --- AWS (optional, for the CloudWatch source) -----------------------------
# Standard credential chain is used if these are unset.
AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
